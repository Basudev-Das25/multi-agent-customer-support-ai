APP_NAME=Multi-Agent Customer Support AI
APP_VERSION=1.0.0

ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

DEBUG=True

MONGODB_URI=
DATABASE_NAME=customer_support_ai

USERS_COLLECTION=users
CONVERSATIONS_COLLECTION=conversations
KNOWLEDGE_COLLECTION=knowledge_documents
ANALYTICS_COLLECTION=analytics

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GOOGLE_API_KEY=

VECTOR_DB_PATH=./vectorstore

UPLOAD_DIRECTORY=storage/uploads/pdfs
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES=application/pdf

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

FAISS_INDEX_PATH=storage/faiss

TOP_K_RESULTS=5

OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT_SECONDS=60

LLM_MAX_TOKENS=1024

LLM_TEMPERATURE=0.2